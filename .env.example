# Copy to .env (gitignored). No value is ever committed.
HOST=127.0.0.1
PORT=8808
DATA_DIR=./data

# The app's own origin as the browser sees it. Default: the Vite dev server.
PUBLIC_ORIGIN=
# The API prefix and the web base as the browser sees them. These are the defaults.
# SHELFMARK_API_PREFIX=/shelfmark-api
# SHELFMARK_BASE=/shelfmark/

# Optional: book lookups skip Google Books when empty.
GOOGLE_BOOKS_API_KEY=

# The first user, created by the seed (brief 06).
SEED_USERNAME=
SEED_PASSWORD=

# "Sign in with Ward" (optional): Ward's local seed.mjs fills these five. With
# WARD_OIDC_ISSUER unset the server runs with local accounts only. The key is a
# secret: never commit a value.
WARD_OIDC_ISSUER=
WARD_OIDC_CLIENT_ID=
WARD_OIDC_CLIENT_KEY=
WARD_OIDC_REDIRECT_URI=
WARD_OIDC_POST_LOGOUT_REDIRECT_URI=
